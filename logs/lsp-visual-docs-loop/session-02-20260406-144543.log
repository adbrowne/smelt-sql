{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012BuepABEiNx1gEA5oss3cm","type":"tool_result","content":"1\t/**\n2\t * Smoke test: verify code-server launches with the smelt extension and the\n3\t * demo workspace loads with working LSP diagnostics.\n4\t */\n5\timport { test, expect } from \"@playwright/test\";\n6\timport {\n7\t  launchCodeServer,\n8\t  type CodeServerHandle,\n9\t} from \"../helpers/code-server.js\";\n10\timport {\n11\t  dismissDialogs,\n12\t  waitForWorkbench,\n13\t  openFile,\n14\t  waitForDiagnostics,\n15\t} from \"../helpers/editor.js\";\n16\timport { screenshot } from \"../helpers/capture.js\";\n17\t\n18\tlet server: CodeServerHandle;\n19\t\n20\ttest.beforeAll(async () => {\n21\t  // Use an already-running code-server if CODE_SERVER_URL is set,\n22\t  // otherwise launch one ourselves.\n23\t  if (!process.env.CODE_SERVER_URL) {\n24\t    server = await launchCodeServer();\n25\t  }\n26\t});\n27\t\n28\ttest.afterAll(async () => {\n29\t  server?.stop();\n30\t});\n31\t\n32\ttest(\"code-server loads the demo workspace\", async ({ page }) => {\n33\t  const url = process.env.CODE_SERVER_URL ?? server.url;\n34\t  await page.goto(url, { waitUntil: \"load\" });\n35\t  await waitForWorkbench(page);\n36\t  await dismissDialogs(page);\n37\t\n38\t  // Verify the workbench loaded\n39\t  await expect(page.locator(\".monaco-workbench\")).toBeVisible();\n40\t\n41\t  await screenshot(page, {\n42\t    feature: \"smoke\",\n43\t    name: \"workbench-loaded\",\n44\t  });\n45\t});\n46\t\n47\ttest(\"smelt extension activates and produces diagnostics\", async ({\n48\t  page,\n49\t}) => {\n50\t  const url = process.env.CODE_SERVER_URL ?? server.url;\n51\t  await page.goto(url, { waitUntil: \"load\" });\n52\t  await waitForWorkbench(page);\n53\t  await dismissDialogs(page);\n54\t\n55\t  // Open a file with a known error — bad_ref.sql has a typo in smelt.ref()\n56\t  await openFile(page, \"bad_ref.sql\");\n57\t\n58\t  // Wait for the LSP to produce diagnostics (squiggly underlines)\n59\t  await waitForDiagnostics(page, { timeout: 45_000 });\n60\t\n61\t  // Verify at least one error decoration is present\n62\t  const errorCount = await page.locator(\".squiggly-error\").count();\n63\t  expect(errorCount).toBeGreaterThan(0);\n64\t\n65\t  await screenshot(page, {\n66\t    feature: \"smoke\",\n67\t    name: \"diagnostics-active\",\n68\t  });\n69\t});\n70\t\n71\ttest(\"clean model has no errors\", async ({ page }) => {\n72\t  const url = process.env.CODE_SERVER_URL ?? server.url;\n73\t  await page.goto(url, { waitUntil: \"load\" });\n74\t  await waitForWorkbench(page);\n75\t  await dismissDialogs(page);\n76\t\n77\t  // Open a model that should be clean\n78\t  await openFile(page, \"stg_users.sql\");\n79\t\n80\t  // Give the LSP time to process\n81\t  await page.waitForTimeout(5000);\n82\t\n83\t  // Should have no error squigglies\n84\t  const errorCount = await page.locator(\".squiggly-error\").count();\n85\t  expect(errorCount).toBe(0);\n86\t\n87\t  await screenshot(page, {\n88\t    feature: \"smoke\",\n89\t    name: \"clean-model\",\n90\t  });\n91\t});\n92\t"}]},"parent_tool_use_id":"toolu_01GSfaLtXvJF47TeeipJt2VA","session_id":"e0b24cd0-9bf2-46e1-9f76-5a7eac82855a","uuid":"ca951e9b-9f59-4c86-b92e-513cbba4fbb1","timestamp":"2026-04-06T04:46:01.802Z"}
