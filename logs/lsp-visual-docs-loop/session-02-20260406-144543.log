{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NkiZgLk6LtxqUndNnMMeWF","type":"tool_result","content":"1\timport { defineConfig } from \"@playwright/test\";\n2\t\n3\t/**\n4\t * Playwright configuration for smelt LSP demos.\n5\t *\n6\t * Expects code-server to be running on CODE_SERVER_URL (default http://localhost:18080).\n7\t * Launch it with: bash scripts/start-code-server.sh\n8\t */\n9\texport default defineConfig({\n10\t  testDir: \"./tests\",\n11\t  timeout: 120_000, // 2 minutes per test — LSP init can be slow\n12\t  retries: 0,\n13\t  workers: 1, // Serial — we share one code-server instance\n14\t  reporter: [[\"list\"], [\"html\", { open: \"never\" }]],\n15\t  use: {\n16\t    baseURL: process.env.CODE_SERVER_URL ?? \"http://localhost:18080\",\n17\t    viewport: { width: 1280, height: 720 },\n18\t    video: \"on\",\n19\t    screenshot: \"on\",\n20\t    trace: \"retain-on-failure\",\n21\t    // Give code-server pages extra time to load\n22\t    navigationTimeout: 30_000,\n23\t    actionTimeout: 15_000,\n24\t  },\n25\t  outputDir: \"./test-results\",\n26\t});\n27\t"}]},"parent_tool_use_id":"toolu_01GSfaLtXvJF47TeeipJt2VA","session_id":"e0b24cd0-9bf2-46e1-9f76-5a7eac82855a","uuid":"a9b4a6bc-7aa2-405c-a960-2cb549666188","timestamp":"2026-04-06T04:46:02.015Z"}
