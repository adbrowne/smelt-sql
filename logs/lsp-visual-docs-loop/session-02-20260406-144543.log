{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LQfC9op7dA26jWcPAVujqD","type":"tool_result","content":"1\t/**\n2\t * Screenshot and video capture helpers with optional annotations.\n3\t */\n4\timport { type Page } from \"@playwright/test\";\n5\timport * as path from \"node:path\";\n6\timport * as fs from \"node:fs\";\n7\t\n8\t/** Base directory for generated media */\n9\texport const MEDIA_DIR = path.resolve(__dirname, \"..\", \"media\");\n10\t\n11\t/**\n12\t * Ensure a media subdirectory exists and return its path.\n13\t */\n14\texport function mediaDir(feature: string): string {\n15\t  const dir = path.join(MEDIA_DIR, feature);\n16\t  fs.mkdirSync(dir, { recursive: true });\n17\t  return dir;\n18\t}\n19\t\n20\texport interface ScreenshotOptions {\n21\t  /** Feature name — used as subdirectory under media/ */\n22\t  feature: string;\n23\t  /** Filename (without extension) */\n24\t  name: string;\n25\t  /** Optional clip region */\n26\t  clip?: { x: number; y: number; width: number; height: number };\n27\t  /** Whether to capture full page */\n28\t  fullPage?: boolean;\n29\t}\n30\t\n31\t/**\n32\t * Take a screenshot and save it to media/<feature>/<name>.png\n33\t * @returns The path to the saved screenshot.\n34\t */\n35\texport async function screenshot(\n36\t  page: Page,\n37\t  opts: ScreenshotOptions\n38\t): Promise<string> {\n39\t  const dir = mediaDir(opts.feature);\n40\t  const filePath = path.join(dir, `${opts.name}.png`);\n41\t\n42\t  await page.screenshot({\n43\t    path: filePath,\n44\t    clip: opts.clip,\n45\t    fullPage: opts.fullPage ?? false,\n46\t  });\n47\t\n48\t  return filePath;\n49\t}\n50\t\n51\t/**\n52\t * Take a screenshot focused on the editor area only (no sidebar/statusbar).\n53\t * Falls back to full-page if the editor area can't be located.\n54\t */\n55\texport async function screenshotEditor(\n56\t  page: Page,\n57\t  opts: Omit<ScreenshotOptions, \"clip\">\n58\t): Promise<string> {\n59\t  const dir = mediaDir(opts.feature);\n60\t  const filePath = path.join(dir, `${opts.name}.png`);\n61\t\n62\t  // Try to screenshot just the editor area\n63\t  const editor = page.locator(\".editor-container\").first();\n64\t  if (await editor.isVisible().catch(() => false)) {\n65\t    await editor.screenshot({ path: filePath });\n66\t  } else {\n67\t    await page.screenshot({ path: filePath });\n68\t  }\n69\t\n70\t  return filePath;\n71\t}\n72\t\n73\t/**\n74\t * Take a screenshot that includes the hover widget or other overlay.\n75\t * Uses full-page screenshot to capture overlays that may be positioned absolutely.\n76\t */\n77\texport async function screenshotWithOverlay(\n78\t  page: Page,\n79\t  opts: Omit<ScreenshotOptions, \"clip\" | \"fullPage\">\n80\t): Promise<string> {\n81\t  const dir = mediaDir(opts.feature);\n82\t  const filePath = path.join(dir, `${opts.name}.png`);\n83\t\n84\t  await page.screenshot({\n85\t    path: filePath,\n86\t    fullPage: false,\n87\t  });\n88\t\n89\t  return filePath;\n90\t}\n91\t"}]},"parent_tool_use_id":"toolu_01GSfaLtXvJF47TeeipJt2VA","session_id":"e0b24cd0-9bf2-46e1-9f76-5a7eac82855a","uuid":"040183f8-cd9d-4a4a-9948-84fa4f66c02a","timestamp":"2026-04-06T04:46:01.590Z"}
