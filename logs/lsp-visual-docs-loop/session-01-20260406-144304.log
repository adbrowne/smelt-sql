{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011eWaxceqBzmYbyBSbTVD6d","type":"tool_result","content":"1\t/**\n2\t * Helpers for launching and managing code-server instances for Playwright tests.\n3\t */\n4\timport { type ChildProcess, spawn } from \"node:child_process\";\n5\timport * as path from \"node:path\";\n6\timport * as net from \"node:net\";\n7\t\n8\t/** Root of the smelt-sql repository */\n9\texport const REPO_ROOT = path.resolve(__dirname, \"..\", \"..\", \"..\");\n10\t\n11\t/** Path to the demo workspace */\n12\texport const DEMO_WORKSPACE = path.join(\n13\t  REPO_ROOT,\n14\t  \"examples\",\n15\t  \"demo_workspace\"\n16\t);\n17\t\n18\t/** Default port for code-server */\n19\texport const DEFAULT_PORT = 18080;\n20\t\n21\t/** Get the base URL for code-server */\n22\texport function codeServerURL(port = DEFAULT_PORT): string {\n23\t  return process.env.CODE_SERVER_URL ?? `http://localhost:${port}`;\n24\t}\n25\t\n26\t/** Path to the packaged VSIX extension */\n27\texport function vsixPath(): string {\n28\t  return path.join(REPO_ROOT, \"editors\", \"vscode\", \"smelt-0.1.0.vsix\");\n29\t}\n30\t\n31\t/** Wait until a TCP port is accepting connections */\n32\tasync function waitForPort(\n33\t  port: number,\n34\t  host = \"127.0.0.1\",\n35\t  timeoutMs = 30_000\n36\t): Promise<void> {\n37\t  const start = Date.now();\n38\t  while (Date.now() - start < timeoutMs) {\n39\t    try {\n40\t      await new Promise<void>((resolve, reject) => {\n41\t        const sock = net.createConnection({ port, host }, () => {\n42\t          sock.destroy();\n43\t          resolve();\n44\t        });\n45\t        sock.on(\"error\", reject);\n46\t      });\n47\t      return;\n48\t    } catch {\n49\t      await new Promise((r) => setTimeout(r, 500));\n50\t    }\n51\t  }\n52\t  throw new Error(`Timed out waiting for port ${port}`);\n53\t}\n54\t\n55\texport interface CodeServerHandle {\n56\t  process: ChildProcess;\n57\t  url: string;\n58\t  port: number;\n59\t  stop(): void;\n60\t}\n61\t\n62\t/**\n63\t * Install the smelt VSIX extension into code-server.\n64\t * This must be done as a separate step before launching the server,\n65\t * because --install-extension causes code-server to exit after installing.\n66\t */\n67\tasync function installExtension(): Promise<void> {\n68\t  const codeServerBin = process.env.CODE_SERVER_BIN ?? \"code-server\";\n69\t  const vsix = vsixPath();\n70\t\n71\t  return new Promise<void>((resolve, reject) => {\n72\t    const child = spawn(\n73\t      codeServerBin,\n74\t      [\"--install-extension\", vsix, \"--force\"],\n75\t      {\n76\t        stdio: [\"ignore\", \"pipe\", \"pipe\"],\n77\t        env: {\n78\t          ...process.env,\n79\t          PATH: `${path.join(REPO_ROOT, \"target\", \"debug\")}:${process.env.PATH}`,\n80\t        },\n81\t      }\n82\t    );\n83\t    child.on(\"close\", (code) => {\n84\t      if (code === 0) resolve();\n85\t      else reject(new Error(`Extension install failed with code ${code}`));\n86\t    });\n87\t    child.on(\"error\", reject);\n88\t  });\n89\t}\n90\t\n91\t/**\n92\t * Launch code-server pointing at the demo workspace with the smelt extension installed.\n93\t *\n94\t * Callers should call handle.stop() in afterAll / teardown.\n95\t */\n96\texport async function launchCodeServer(\n97\t  opts: {\n98\t    port?: number;\n99\t    skipExtensionInstall?: boolean;\n100\t  } = {}\n101\t): Promise<CodeServerHandle> {\n102\t  const port = opts.port ?? DEFAULT_PORT;\n103\t\n104\t  // Install the extension first (separate step — code-server exits after install)\n105\t  if (!opts.skipExtensionInstall) {\n106\t    await installExtension();\n107\t  }\n108\t\n109\t  const args: string[] = [\n110\t    \"--port\",\n111\t    String(port),\n112\t    \"--auth\",\n113\t    \"none\",\n114\t    \"--disable-telemetry\",\n115\t    \"--disable-update-check\",\n116\t    \"--disable-workspace-trust\",\n117\t    \"--disable-getting-started-override\",\n118\t    DEMO_WORKSPACE,\n119\t  ];\n120\t\n121\t  const codeServerBin =\n122\t    process.env.CODE_SERVER_BIN ?? \"code-server\";\n123\t\n124\t  const child = spawn(codeServerBin, args, {\n125\t    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n126\t    env: {\n127\t      ...process.env,\n128\t      // Ensure the smelt LSP binary is on the PATH — built with cargo build -p smelt-lsp\n129\t      PATH: `${path.join(REPO_ROOT, \"target\", \"debug\")}:${process.env.PATH}`,\n130\t    },\n131\t  });\n132\t\n133\t  // Log stderr for debugging\n134\t  child.stderr?.on(\"data\", (chunk: Buffer) => {\n135\t    if (process.env.DEBUG) {\n136\t      process.stderr.write(`[code-server] ${chunk}`);\n137\t    }\n138\t  });\n139\t\n140\t  await waitForPort(port);\n141\t\n142\t  const url = `http://localhost:${port}`;\n143\t  return {\n144\t    process: child,\n145\t    url,\n146\t    port,\n147\t    stop() {\n148\t      child.kill(\"SIGTERM\");\n149\t    },\n150\t  };\n151\t}\n152\t"}]},"parent_tool_use_id":null,"session_id":"05b1b068-6028-4f68-a58e-10ea723d627b","uuid":"8507fcd7-c20b-4b41-8606-9dc600dbbea5","timestamp":"2026-04-06T04:43:29.027Z","tool_use_result":{"type":"text","file":{"filePath":"/home/andrew/smelt-sql/.claude/worktrees/lspdemo/docs/demos/helpers/code-server.ts","content":"/**\n * Helpers for launching and managing code-server instances for Playwright tests.\n */\nimport { type ChildProcess, spawn } from \"node:child_process\";\nimport * as path from \"node:path\";\nimport * as net from \"node:net\";\n\n/** Root of the smelt-sql repository */\nexport const REPO_ROOT = path.resolve(__dirname, \"..\", \"..\", \"..\");\n\n/** Path to the demo workspace */\nexport const DEMO_WORKSPACE = path.join(\n  REPO_ROOT,\n  \"examples\",\n  \"demo_workspace\"\n);\n\n/** Default port for code-server */\nexport const DEFAULT_PORT = 18080;\n\n/** Get the base URL for code-server */\nexport function codeServerURL(port = DEFAULT_PORT): string {\n  return process.env.CODE_SERVER_URL ?? `http://localhost:${port}`;\n}\n\n/** Path to the packaged VSIX extension */\nexport function vsixPath(): string {\n  return path.join(REPO_ROOT, \"editors\", \"vscode\", \"smelt-0.1.0.vsix\");\n}\n\n/** Wait until a TCP port is accepting connections */\nasync function waitForPort(\n  port: number,\n  host = \"127.0.0.1\",\n  timeoutMs = 30_000\n): Promise<void> {\n  const start = Date.now();\n  while (Date.now() - start < timeoutMs) {\n    try {\n      await new Promise<void>((resolve, reject) => {\n        const sock = net.createConnection({ port, host }, () => {\n          sock.destroy();\n          resolve();\n        });\n        sock.on(\"error\", reject);\n      });\n      return;\n    } catch {\n      await new Promise((r) => setTimeout(r, 500));\n    }\n  }\n  throw new Error(`Timed out waiting for port ${port}`);\n}\n\nexport interface CodeServerHandle {\n  process: ChildProcess;\n  url: string;\n  port: number;\n  stop(): void;\n}\n\n/**\n * Install the smelt VSIX extension into code-server.\n * This must be done as a separate step before launching the server,\n * because --install-extension causes code-server to exit after installing.\n */\nasync function installExtension(): Promise<void> {\n  const codeServerBin = process.env.CODE_SERVER_BIN ?? \"code-server\";\n  const vsix = vsixPath();\n\n  return new Promise<void>((resolve, reject) => {\n    const child = spawn(\n      codeServerBin,\n      [\"--install-extension\", vsix, \"--force\"],\n      {\n        stdio: [\"ignore\", \"pipe\", \"pipe\"],\n        env: {\n          ...process.env,\n          PATH: `${path.join(REPO_ROOT, \"target\", \"debug\")}:${process.env.PATH}`,\n        },\n      }\n    );\n    child.on(\"close\", (code) => {\n      if (code === 0) resolve();\n      else reject(new Error(`Extension install failed with code ${code}`));\n    });\n    child.on(\"error\", reject);\n  });\n}\n\n/**\n * Launch code-server pointing at the demo workspace with the smelt extension installed.\n *\n * Callers should call handle.stop() in afterAll / teardown.\n */\nexport async function launchCodeServer(\n  opts: {\n    port?: number;\n    skipExtensionInstall?: boolean;\n  } = {}\n): Promise<CodeServerHandle> {\n  const port = opts.port ?? DEFAULT_PORT;\n\n  // Install the extension first (separate step — code-server exits after install)\n  if (!opts.skipExtensionInstall) {\n    await installExtension();\n  }\n\n  const args: string[] = [\n    \"--port\",\n    String(port),\n    \"--auth\",\n    \"none\",\n    \"--disable-telemetry\",\n    \"--disable-update-check\",\n    \"--disable-workspace-trust\",\n    \"--disable-getting-started-override\",\n    DEMO_WORKSPACE,\n  ];\n\n  const codeServerBin =\n    process.env.CODE_SERVER_BIN ?? \"code-server\";\n\n  const child = spawn(codeServerBin, args, {\n    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    env: {\n      ...process.env,\n      // Ensure the smelt LSP binary is on the PATH — built with cargo build -p smelt-lsp\n      PATH: `${path.join(REPO_ROOT, \"target\", \"debug\")}:${process.env.PATH}`,\n    },\n  });\n\n  // Log stderr for debugging\n  child.stderr?.on(\"data\", (chunk: Buffer) => {\n    if (process.env.DEBUG) {\n      process.stderr.write(`[code-server] ${chunk}`);\n    }\n  });\n\n  await waitForPort(port);\n\n  const url = `http://localhost:${port}`;\n  return {\n    process: child,\n    url,\n    port,\n    stop() {\n      child.kill(\"SIGTERM\");\n    },\n  };\n}\n","numLines":152,"startLine":1,"totalLines":152}}}
