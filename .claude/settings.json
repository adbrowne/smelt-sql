{
  "permissions": {
    "deny": [
      "Bash(gcloud)",
      "Bash(gcloud *)",
      "Bash(bq)",
      "Bash(bq *)",
      "Bash(bash scripts/bigquery-key.sh*)",
      "Bash(bash scripts/bigquery-provision.sh*)",
      "Bash(bash scripts/bigquery-login.sh*)",
      "Bash(bash scripts/bigquery-auth.sh*)",
      "Bash(./scripts/bigquery-auth.sh*)",
      "Bash(bash scripts/bigquery-setup.sh*)",
      "Bash(./scripts/bigquery-setup.sh*)",
      "Read(//home/andrew/.config/gcloud-smelt-bq/**)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.command | test(\"\\\\bpgrep\\\\b\\\\s+-[a-zA-Z]*f\")' >/dev/null 2>&1 && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"`pgrep -f` is blocked: it self-matches when its own cmdline contains the search pattern, which deadlocks polling loops (e.g. `while pgrep -f \\\"cargo test\\\"; do sleep N; done` finds itself). Use the Monitor tool to watch background processes, `wait <pid>` if you spawned them, or `pgrep` without -f (matches process name only).\"}}' || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/log-tool-call.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/log-session-end.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
