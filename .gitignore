target/
.cargo-cache/
# Local developer build-speed config (e.g. mold linker). Not normative to the
# project — must not be committed, since it would apply to CI and every
# contributor (where the chosen linker may not be installed).
.cargo/config.toml
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/skills/
!.claude/scripts/
!.claude/active-plan
!.claude/outcome-backlog
!.claude/outcome-plan-prompt.txt
!.claude/outcome-implement-prompt.txt
!.claude/hardening-baseline.txt
!.claude/parser-gaps-baseline.txt
!.claude/dialect-gaps-baseline.txt
!.claude/registry-migration-baseline.txt
!.claude/unknown-census.toml
!.claude/property-loop-prompt.txt
/.vscode/
datagen.duckdb
output/
__pycache__/
*.pyc
*.egg-info/
.venv/

# Example build artifacts
examples/*/target/
examples/*/.smelt/
examples/*/data/

# Datagen output landing at the repo root when smelt-datagen is invoked
# with a relative `output:` path from the workspace root (tests use temp
# dirs; this catches ad-hoc CLI runs).
/data/

# UI
/node_modules/
ui/node_modules/
ui/dist/

# Docs site build output
docs-site/site/

# Maturin wheel data (created in CI)
smelt_sql.data/

# Local maturin wheel builds (used by the agent-loop harness)
/dist/

# Local Spark Connect runtime (scripts/spark-up.sh) — not committed
.smelt-spark-warehouse/
.smelt-spark-venv/
.smelt-bq-venv/
# Delta Lake Ivy cache (bind-mounted into the container; files owned by the
# container's uid 185, so the host loop's auto-stash/clean cannot remove them —
# gitignore it to avoid "Permission denied" warnings on every iteration).
.smelt-spark-ivy/
